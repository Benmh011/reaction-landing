# ─────────────── REACTION ENV VARS ───────────────
# Copy this file to .env.local for local dev, and add the SAME variables
# to your Vercel project under Settings → Environment Variables.

# ─── Database (Vercel Postgres / Neon) ───
# After provisioning Vercel Postgres, all six of these are set automatically
# in the Vercel dashboard. For local dev, paste the values from Vercel.
DATABASE_URL="postgres://..."
DIRECT_URL="postgres://..."

# ─── Auth.js (next-auth v5) ───
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-32-byte-string"
# Set to your live URL in production. Auth.js usually figures this out from
# Vercel's VERCEL_URL automatically, but set it explicitly to be safe.
AUTH_URL="https://reaction.org.uk"

# ─── Resend (transactional email) ───
# Get from https://resend.com/api-keys after verifying reaction.org.uk
RESEND_API_KEY="re_..."
# This must be an address on a domain you've verified in Resend
EMAIL_FROM="Reaction <hello@reaction.org.uk>"

# ─── Admin notifications ───
# Where new demo requests get sent
ADMIN_EMAIL="info@reaction.org.uk"

# ─── Admin login ───
# Bootstrap admin account — create on first deploy by visiting /admin/setup
ADMIN_EMAIL_INITIAL="info@reaction.org.uk"
ADMIN_PASSWORD_INITIAL="change-me-on-first-login-with-something-strong"

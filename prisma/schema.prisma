// Prisma schema for Reaction
// Run `npx prisma db push` to sync the schema to your Postgres database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────── DEMO REQUESTS ───────────────
// Captures everyone who fills the "Register interest" form on /demo.
// Status moves: PENDING (just submitted) → APPROVED (admin granted access,
// user account created and magic-link sent) or REJECTED.
model DemoRequest {
  id           String          @id @default(cuid())
  createdAt    DateTime        @default(now())
  email        String
  name         String
  organisation String
  role         String?
  message      String?
  // Business sector (free text from the demo form's sector select)
  sector       String?
  // What kind of organisation this person represents.
  // Drives admin UX and which demo version gets defaulted on approval.
  requestType  RequestType     @default(BUSINESS)
  status       DemoRequestStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedBy   String?
  notes        String?

  // Once approved, link to the User that was created so we can
  // jump from request → portal user in the admin panel.
  approvedUser   User?   @relation(fields: [approvedUserId], references: [id])
  approvedUserId String? @unique

  @@index([status, createdAt])
  @@index([requestType])
}

enum DemoRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestType {
  BUSINESS
  UNIVERSITY
  STUDENTS_UNION
  EMPLOYER
  CHARITY
  OTHER
}

// ─────────────── AUTH.JS MODELS ───────────────
// Standard Auth.js Prisma adapter schema, with extra fields for our portal.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?

  // Optional bcrypt password hash for fallback login
  passwordHash  String?

  // Role determines top-level access — CLIENT users see /portal, ADMIN sees everything,
  // STUDENT is the pilot participant role (scoped to a cohort, limited surfaces).
  role          UserRole  @default(CLIENT)

  // What kind of organisation this user represents (mirrored from DemoRequest)
  // Useful for filtering /admin/users by audience type.
  requestType   RequestType @default(BUSINESS)

  // Bespoke-version pointer: which build of the React app this client should
  // see when they hit /portal. Refers to a folder name under /private-demos/
  // that the admin sets when approving the user. Null until configured.
  demoVersion   String?
  organisation  String?

  // Pilot cohort identifier (e.g. "plymouth-pilot-2026-q2"). Set for STUDENT users.
  // Null for CLIENT and ADMIN users. Drives which pilot data this user can see/write.
  pilotCohort   String?

  // When true, this user has unsubscribed from marketing emails. Transactional
  // emails (magic-link sign-in etc.) are unaffected by this flag.
  marketingOptOut Boolean @default(false)

  accounts      Account[]
  sessions      Session[]
  demoRequest   DemoRequest?

  // Pilot relations
  pilotPosts        PilotPost[]        @relation("PilotPostAuthor")
  pilotAttendances  PilotAttendance[]  @relation("PilotAttendanceUser")
  pilotCheckins     PilotCheckin[]     @relation("PilotCheckinUser")
  pilotReflections  PilotReflection[]  @relation("PilotReflectionUser")
  pilotOutcomes     PilotOutcome[]     @relation("PilotOutcomeUser")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum UserRole {
  CLIENT
  ADMIN
  STUDENT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Magic-link tokens stored here by Auth.js when sending email-verification login
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────── EMAIL OPT-OUT TOMBSTONE ───────────────
// Captures unsubscribes from prospects who never registered an account.
// When a User exists, their marketingOptOut field is also set. This table
// catches the case where someone submitted /demo, got the acknowledgment
// email, clicked Unsubscribe — but never became a User.
//
// Before sending any marketing email, check both:
//   1. User.marketingOptOut (if a User exists)
//   2. EmailOptOut existence (catches non-User prospects)
model EmailOptOut {
  email      String   @id
  optedOutAt DateTime @default(now())
}


// ═══════════════════════════════════════════════════════════════════
// PILOT TABLES
// ═══════════════════════════════════════════════════════════════════
// Used for live data capture during the Plymouth pilot (and future cohorts).
// All rows are scoped to a `cohort` string (on PilotPost) so multiple pilots
// can run in parallel without leakage. The pilot UI only writes to these tables;
// the existing sales demo continues to run entirely on seed state and never
// touches them.

// User-created posts inside a pilot board. Replaces the JSX seed data the
// sales demo uses. `category` is constrained at the API layer to:
//   "Sport" | "Study" | "Board Games" | "Community"
// Opportunities is locked in the pilot UI and rejected server-side.
model PilotPost {
  id          String   @id @default(cuid())
  cohort      String   // e.g. "plymouth-pilot-2026-q2" — students only see their own cohort's posts
  authorId    String   // who created the post (a STUDENT user)
  category    String   // see comment above
  activity    String   // e.g. "Football", "Group Revision", "Beach Clean"
  location    String
  date        String   // ISO date string e.g. "2026-06-14"
  time        String   // e.g. "14:00"
  description String?
  // Flexible field for category-specific extras (mode, perTeam, maxPeople,
  // skillLevel, cause, etc.) Keeps the schema small while accommodating the
  // post shapes the demo already understands.
  metadata    Json?
  createdAt   DateTime @default(now())

  author       User              @relation("PilotPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  attendances  PilotAttendance[]
  checkins     PilotCheckin[]
  reflections  PilotReflection[]
  outcomes     PilotOutcome[]

  @@index([cohort, createdAt])
  @@index([category])
}

// One row per student RSVP to a pilot post.
model PilotAttendance {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User      @relation("PilotAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  post PilotPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

// Captured when a student confirms they actually attended a past event.
// Distinct from PilotAttendance: attendance is "I plan to come", check-in is "I came".
model PilotCheckin {
  id          String   @id @default(cuid())
  userId      String
  postId      String
  checkedInAt DateTime @default(now())

  user User      @relation("PilotCheckinUser", fields: [userId], references: [id], onDelete: Cascade)
  post PilotPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

// The post-event Likert + free-text capture. Anchors all SO4-SO6 evidence.
// Likert values 1-5, validated at the API layer.
model PilotReflection {
  id         String   @id @default(cuid())
  userId     String
  postId     String
  // Likert values 1-5; null when the student opted out (see `skipped` below).
  // The API layer validates that these are present and 1-5 when skipped=false.
  belonging  Int?     // (NSS B2.1) "I felt I belonged at this event"
  learned    Int?     // (TEF SO6)  "I learned something I'll use again"
  connection Int?     // (TEF SO5)  "I made or strengthened a peer connection"
  oneThing   String?  // (TEF SO4)  Free-text articulation; nullable either way
  // True when the student explicitly chose to skip reflecting on this event.
  // Treated equivalently to "reflection complete" for the purpose of hiding
  // the post from the student's board — they've made their decision.
  skipped    Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User      @relation("PilotReflectionUser", fields: [userId], references: [id], onDelete: Cascade)
  post PilotPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([createdAt])
}

// Kept in the schema for future use (Tier 2 opportunities work). Not surfaced
// in the pilot UI yet — Opportunities board is locked. Safe to leave; API layer
// simply won't write to it during the pilot phase.
model PilotOutcome {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  status    String   // no-response | rejected | interviewed | offered | accepted
  oneThing  String?
  createdAt DateTime @default(now())

  user User      @relation("PilotOutcomeUser", fields: [userId], references: [id], onDelete: Cascade)
  post PilotPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([createdAt])
}

// ─────────────── ANALYTICS (first-party) ───────────────
// Powers the /analytics dashboard. Written by the client beacon
// (components/SiteAnalytics.tsx) via POST /api/track. Tables created with raw
// SQL (db/analytics.sql) — do NOT run prisma migrate / db push on this project.

model PageView {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  path      String
  referrer  String?
  sessionId String   // anonymous first-party visitor id (per-browser)
  country   String?
  device    String?  // "mobile" | "tablet" | "desktop"

  @@index([createdAt])
  @@index([sessionId])
  @@index([path])
}

// One row per visit to a demo surface (/portal, /demo-app/*). durationMs is
// finalised by a beacon fired when the visitor leaves the demo.
model DemoSession {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  slug       String
  sessionId  String
  userId     String?
  durationMs Int      @default(0)

  @@index([createdAt])
  @@index([slug])
}

// Business / agent metrics for deployed client systems. Fed by client agent
// pipelines or the admin. Dashboard shows the latest value per (client, metric).
model AgentMetric {
  id         String   @id @default(cuid())
  capturedAt DateTime @default(now())
  client     String
  metric     String   // e.g. "tasks_automated", "hours_saved", "agent_runs"
  value      Float
  unit       String?

  @@index([client, metric, capturedAt])
}

// ─────────────── DEMO CATALOGUE ───────────────
// The launchable demos shown on /demo, managed at /admin/demos (owner-only).
// launchUrl points at the hosted software itself (e.g. the Southmoor Vets
// assistant on reactionbusinessservices.co.uk) — the destination's own login
// wall is the access gate. accessNote is private, shown only in the manager.
// Table created via raw SQL (db/business-demos.sql) — never prisma migrate.

model Demo {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
  name        String
  description String
  launchUrl   String
  accessNote  String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)

  @@index([active, sortOrder])
}

// ─────────────── ARTICLED (hosted demo) ───────────────
// Ported 1:1 from Benmh011/articled, namespaced so it shares reaction's Neon
// without colliding. pgvector setup (run once on Neon, before generating):
//   CREATE EXTENSION IF NOT EXISTS vector;
// After the tables exist, the similarity index:
//   CREATE INDEX IF NOT EXISTS articled_kbchunk_embedding_idx
//     ON "ArticledKbChunk" USING hnsw (embedding vector_cosine_ops);
// Tables are created via raw SQL (db/articled.sql) — never prisma migrate/db push.

model ArticledKbChunk {
  id        String                       @id @default(cuid())
  sourceId  String                       @unique
  kind      String // "frs" | "firm" | "hmrc"
  ref       String
  title     String
  category  String?
  flag      Boolean                      @default(false)
  content   String
  embedding Unsupported("vector(1024)")?
  createdAt DateTime                     @default(now())

  @@index([kind])
}

model ArticledAuditTurn {
  id             String   @id @default(cuid())
  userId         String?
  conversationId String?
  question       String
  answer         String
  sourceRefs     String[]
  model          String
  latencyMs      Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([conversationId])
}

model ArticledConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model ArticledChatFile {
  id             String   @id @default(cuid())
  auditTurnId    String?
  conversationId String
  userId         String
  filename       String
  mimeType       String
  kind           String // "result" | "upload"
  data           Bytes
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([auditTurnId])
}
